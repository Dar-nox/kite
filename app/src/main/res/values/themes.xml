<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      The activity theme. Compose draws everything, so this exists only to make the window match the
      app background before the first frame: #0F0F0F is the `background` token from DESIGN.md.
      There is no light variant because the app has no light theme.
    -->
    <style name="Theme.Kite" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kite_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
